rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['jemipadodara@gmail.com', 'auditor@vigilai.gov.in', 'admin@vigilai.gov.in', 'minister@mplads.vigilai'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'minister', 'ministry', 'district', 'state'])
      );
    }

    function isOfficer() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['minister', 'nodal_officer', 'mp', 'analyst', 'district', 'state', 'ministry'])
      );
    }

    // User Profiles with RBAC
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isOfficer());
      allow create: if isSignedIn() && isOwner(userId) && isValidId(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if false;
    }

    // Constituencies: Publicly readable by all citizens & officials
    match /constituencies/{constituencyId} {
      allow read: if true;
      allow create, update: if isOfficer();
      allow delete: if isAdmin();
    }

    // Projects: Publicly readable audit records; updates restricted to authorized officers
    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if isOfficer();
      allow delete: if isAdmin();
    }

    // Alerts: AI Vigilance Alerts (Publicly readable)
    match /alerts/{alertId} {
      allow read: if true;
      allow create, update: if isOfficer();
      allow delete: if isAdmin();
    }

    // Cases: Vigilance Case Dockets
    match /cases/{caseId} {
      allow read: if true;
      allow create, update: if isOfficer();
      allow delete: if isAdmin();
    }

    // Inspections: Field Inspection Workbenches
    match /inspections/{inspectionId} {
      allow read: if true;
      allow create, update: if isOfficer();
      allow delete: if isAdmin();
    }

    // Citizen Reports: Community Watchdog reports (Publicly readable, open submissions)
    match /citizen_reports/{reportId} {
      allow read: if true;
      allow create: if isValidId(reportId);
      allow update: if isOfficer();
      allow delete: if isAdmin();
    }

    // Citizen Verifications: Ground reality check reports
    match /citizen_verifications/{verificationId} {
      allow read: if true;
      allow create: if isValidId(verificationId);
      allow update: if isOfficer();
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if true;
      allow create, update: if isOfficer();
      allow delete: if isAdmin();
    }

    // Minister Actions: Publicly readable for total transparency, writeable by ministers / officers
    match /minister_actions/{actionId} {
      allow read: if true;
      allow create, update: if isOfficer();
      allow delete: if isAdmin();
    }

    // Audit Logs: Strictly Officer / Admin access, append-only
    match /audit_logs/{logId} {
      allow read: if isOfficer();
      allow create: if isOfficer() && isValidId(logId);
      allow update, delete: if false;
    }
  }
}
