rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidConstituency(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.name is string && data.name.size() <= 100 &&
             data.state is string && data.state.size() <= 60 &&
             data.seatCode is string && data.seatCode.size() <= 30 &&
             data.mpName is string && data.mpName.size() <= 100 &&
             data.riskTier in ['HIGH', 'MEDIUM', 'LOW'] &&
             data.riskScore is number && data.riskScore >= 0 && data.riskScore <= 100;
    }

    function isValidProject(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.constituencyId is string && data.constituencyId.size() <= 64 &&
             data.workCode is string && data.workCode.size() <= 64 &&
             data.title is string && data.title.size() <= 200 &&
             data.sanctionedAmountLakhs is number && data.sanctionedAmountLakhs >= 0 &&
             data.status is string && data.status.size() <= 80;
    }

    function isValidAlert(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.constituencyId is string && data.constituencyId.size() <= 64 &&
             data.severity in ['HIGH', 'MEDIUM', 'LOW'] &&
             data.title is string && data.title.size() <= 150 &&
             data.description is string && data.description.size() <= 1000;
    }

    function isValidCitizenReport(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.constituencyId is string && data.constituencyId.size() <= 64 &&
             data.issueType is string && data.issueType.size() <= 100 &&
             data.description is string && data.description.size() <= 2000 &&
             data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['jemipadodara@gmail.com', 'auditor@vigilai.gov.in', 'admin@vigilai.gov.in'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 64 &&
             data.email is string && data.email.size() <= 120 &&
             data.role in ['admin', 'citizen', 'standard'] &&
             data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidCitizenVerification(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.projectId is string && data.projectId.size() <= 64 &&
             data.status in ['Completed', 'Incomplete', 'Not Found', 'Wrong Location', 'Damaged', 'Not Operational', 'Quality Concern', 'Other'] &&
             data.description is string && data.description.size() <= 2000 &&
             data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidAuditLog(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.action is string && data.action.size() <= 100 &&
             data.userEmail is string && data.userEmail.size() <= 120 &&
             data.timestamp is string && data.timestamp.size() <= 40;
    }

    // User Profiles with RBAC
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow update: if isSignedIn() && isValidUserProfile(request.resource.data) && (isOwner(userId) || isAdmin());
      allow delete: if false;
    }

    // Constituencies: Publicly readable by all citizens & officials
    match /constituencies/{constituencyId} {
      allow read: if true;
      allow create, update: if isAdmin() || (isValidId(constituencyId) && isValidConstituency(request.resource.data));
      allow delete: if isAdmin();
    }

    // Projects: Publicly readable audit records; updates restricted to Admins
    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if isAdmin() || (isValidId(projectId) && isValidProject(request.resource.data));
      allow delete: if isAdmin();
    }

    // Alerts: AI Vigilance Alerts (Publicly readable)
    match /alerts/{alertId} {
      allow read: if true;
      allow create, update: if isAdmin() || (isValidId(alertId) && isValidAlert(request.resource.data));
      allow delete: if isAdmin();
    }

    // Citizen Reports: Community Watchdog reports
    match /citizen_reports/{reportId} {
      allow read: if true;
      allow create: if isValidId(reportId) && isValidCitizenReport(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Citizen Verifications: Ground reality check reports
    match /citizen_verifications/{verificationId} {
      allow read: if true;
      allow create: if isValidId(verificationId) && isValidCitizenVerification(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Audit Logs: Strictly Admin only
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(logId) && isValidAuditLog(request.resource.data);
      allow update, delete: if false;
    }
  }
}
